   "source": "model_order = ['cnn', 'faster_rcnn_original', 'vgg16', 'alexnet', 'vit']\ncomparison = []\nfor key in model_order:\n    if key == 'faster_rcnn_original':\n        comparison.append({'model': key, 'source': 'historical notebook output; not rerun',\n                           'accuracy': 0.9922, 'f1_macro': 0.9921, 'test_loss': None,\n                           'training_seconds': 79.9 * 60, 'gpu_count_used': 2, 'epochs_executed': 8,\n                           'train_size': 59000, 'validation_size': 1000,\n                           'note': 'From scratch, 64x64; validation BatchNorm updates and no-detection fallback limit reliability.'})\n    else:\n        path = PROJECT / 'runs' / key / 'metrics.json'\n        if path.exists():\n            comparison.append(json.loads(path.read_text()))\n        else:\n            comparison.append({'model': key, 'source': 'not yet evaluated'})\ncurrent_runs = [row for row in comparison if row.get('source') == 'new_colab_run']\nif len({row['split_sha256'] for row in current_runs}) > 1:\n    raise RuntimeError('Cannot combine runs with different dataset splits.')\nif len({json.dumps(row['dataset_file_sha256'], sort_keys=True) for row in current_runs}) > 1:\n    raise RuntimeError('Cannot combine runs whose Kaggle MNIST file fingerprints differ.')\n\ndef metric_text(value, percent=False):\n    if value is None: return '—'\n    return f'{value:.2%}' if percent else f'{value:.4f}'\n\nlines = ['| Model | Test accuracy | Macro F1 | Test loss | Time (min) | GPUs | Epochs | Source |',\n         '|---|---:|---:|---:|---:|---:|---:|---|']\nfor row in comparison:\n    minutes = f'{row[\"training_seconds\"] / 60:.2f}' if 'training_seconds' in row else '—'\n    lines.append(f'| {row[\"model\"]} | {metric_text(row.get(\"accuracy\"), True)} | '\n                 f'{metric_text(row.get(\"f1_macro\"))} | {metric_text(row.get(\"test_loss\"))} | '\n                 f'{minutes} | {row.get(\"gpu_count_used\", \"—\")} | {row.get(\"epochs_executed\", \"—\")} | {row[\"source\"]} |')\ntable = '\\n'.join(lines)\nprint(table)\nwrite_json(PROJECT / 'comparison.json', comparison)\n(PROJECT / 'comparison.md').write_text(table + '\\n\\nHistorical Faster R-CNN results use a different protocol and retain known evaluation limitations. '\n                                      'Times include validation and checkpoint writes for the new runs. '\n                                      'Do not rank detection loss against classification cross-entropy.\\n')\nprint('Saved:', PROJECT / 'comparison.md')\n",
